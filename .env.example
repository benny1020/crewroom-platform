# Local preview is bound to loopback. Production requires HTTPS and the override.
PUBLIC_ORIGIN=http://localhost:4180
PORT=4180
BIND_ADDRESS=127.0.0.1
NODE_ENV=development
CREWROOM_SECRETS_DIR=./.local/secrets
# OpenAI-compatible chat completion endpoint, e.g. https://provider.example/v1
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_NAME=
# Put a real key in .local/secrets/model_api_key. Never commit credentials.
# For production override: PUBLIC_ORIGIN=https://crewroom.example.com
# SITE_ADDRESS=crewroom.example.com
# Custom endpoint: full URL overrides MODEL_BASE_URL's default path.
MODEL_ENDPOINT_URL=
MODEL_AUTH_HEADER=
MODEL_AUTH_SCHEME=auto
MODEL_API_VERSION=2023-06-01
GITHUB_ENABLED=1
GITLAB_BASE_URL=
GITLAB_PROJECTS=
GITLAB_SHARED_PROJECTS=
# GitLab token: .local/secrets/gitlab_token. See deploy/custom.env.example.

# Model output/time limits and optional separate execution broker.
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_TIMEOUT_MS=120000
# RUNNER_URL=http://runner:4191

# Optional OpenAI-compatible embeddings. Empty keeps all recall local/keyword-based.
# Text inference endpoints do not automatically provide embeddings.
EMBEDDING_ENDPOINT_URL=
EMBEDDING_MODEL=
EMBEDDING_AUTH_HEADER=
EMBEDDING_AUTH_SCHEME=auto
# Key file: .local/secrets/embedding_api_key (Worker only).
