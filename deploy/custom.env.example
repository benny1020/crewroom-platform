# Copy to .env for a deployment with custom model and GitLab URLs.
NODE_ENV=production
PUBLIC_ORIGIN=https://crewroom.example.com
PORT=4180
BIND_ADDRESS=127.0.0.1
CREWROOM_SECRETS_DIR=./.local/secrets

# OpenAI-compatible Chat Completions. For Claude Messages use anthropic,
# a /v1/messages endpoint, x-api-key and raw authentication instead.
MODEL_PROVIDER=openai-compatible
MODEL_NAME=your-model-id
MODEL_ENDPOINT_URL=https://models.example.com/v1/chat/completions
MODEL_AUTH_HEADER=authorization
MODEL_AUTH_SCHEME=bearer
MODEL_API_VERSION=2023-06-01

# GitLab root, including a deployment subpath when applicable.
GITHUB_ENABLED=1
GITLAB_BASE_URL=https://git.example.com
GITLAB_PROJECTS=team/project
# Leave blank for private work only. Add a project here only when the intended
# shared audience has access to its code and artifacts.
GITLAB_SHARED_PROJECTS=
# Secrets: .local/secrets/model_api_key and .local/secrets/gitlab_token

# Model output/time limits and optional separate execution broker.
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_TIMEOUT_MS=120000
# RUNNER_URL=http://runner:4191

# Optional OpenAI-compatible embeddings. Empty keeps all recall local/keyword-based.
# Text inference endpoints do not automatically provide embeddings.
EMBEDDING_ENDPOINT_URL=
EMBEDDING_MODEL=
EMBEDDING_AUTH_HEADER=
EMBEDDING_AUTH_SCHEME=auto
# Key file: .local/secrets/embedding_api_key (Worker only).
